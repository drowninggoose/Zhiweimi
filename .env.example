# 这些变量只由 Vite 的 Node 服务端读取，不要使用 VITE_ 前缀。
# 复制本文件为 .env 后填入真实 Key；.env 已被 .gitignore 忽略，不会提交。
# 注意：本示例文件会进入仓库与提交包，只能放占位符，绝不能填真实密钥。

# ===== 餐具识别 / 步骤调整（走 aihubmix）=====
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gemini-2.5-flash-lite
AI_BASE_URL=https://aihubmix.com/v1

# ===== 语音助手（走阿里云百炼，与上面的 AI_ 完全隔离）=====
# 百炼控制台 → API-KEY 创建，注意地域选「华北2（北京）」
VOICE_API_KEY=your-voice-api-key-here
# 对话模型（OpenAI 兼容接口）
VOICE_MODEL=qwen3.7-flash
VOICE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 语音识别走 DashScope 原生接口，因此单独给 base
VOICE_DASHSCOPE_BASE=https://dashscope.aliyuncs.com
VOICE_ASR_MODEL=qwen-audio-3.1-asr-flash
# 如果百炼 Key 是工作空间专用 Key（sk-ws- 开头），填写控制台里的工作空间 ID：
# VOICE_WORKSPACE_ID=ws-xxxxxxxxxxxx
