{
  "name": "zhiweimi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --import ./scripts/tmp-env.mjs ./node_modules/vite/bin/vite.js",
    "build": "tsc -b && node --import ./scripts/tmp-env.mjs ./node_modules/vite/bin/vite.js build",
    "preview": "node --import ./scripts/tmp-env.mjs ./node_modules/vite/bin/vite.js preview",
    "test": "node --import ./scripts/tmp-env.mjs ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --import ./scripts/tmp-env.mjs ./node_modules/vitest/vitest.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "clean:recipes": "node tools/clean-recipes.mjs",
    "localize:recipe-images": "node tools/localize-recipe-images.mjs",
    "lint": "eslint .",
    "format": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/ma-shan-zheng": "^5.3.1",
    "@fontsource/zcool-xiaowei": "^5.3.0",
    "dexie": "^4.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.4",
    "globals": "^16.4.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.12",
    "vitest": "^5.0.3"
  }
}
